# ============================================================================
#  .env.example — конфігурація дипломної ІС
#  ---------------------------------------------------------------------------
#  Скопіюйте у `.env`:  cp .env.example .env  і запускайте `docker compose up`.
#  Цей файл уже містить готовий до роботи список RSS-стрічок —
#  без жодних додаткових ключів система зможе збирати реальні новини.
#  Telegram / X / Reddit вмикаються опційно (див. нижче).
# ============================================================================

# ----- Базові налаштування backend (Node.js) -----
PORT=3000
NLP_SERVICE_URL=http://127.0.0.1:8000
MAX_POSTS=500

# ----- Демо-дані (моки Twitter / FB / TG) -----
# 1 = система додає синтетичні пости для джерел без реального API.
# 0 = тільки реальні дані (Telegram, RSS, X, Reddit — залежно від ключів нижче).
# За замовчуванням вимкнено. Увімкніть, якщо хочете побачити, як виглядає
# візуалізація з повним набором джерел (для презентації UI).
ALLOW_MOCK=0

# ----- Redis-черга для NLP (опційно) -----
# У docker-compose це вже задано автоматично (REDIS_URL=redis://redis:6379).
# Розкоментуйте лише якщо запускаєте локально без Docker.
# REDIS_URL=redis://127.0.0.1:6379

# ============================================================================
#  RSS / новини — ПРАЦЮЄ БЕЗ КЛЮЧІВ
# ============================================================================
# Список URL стрічок через кому (без пробілів між адресами).
# 15 стабільних стрічок українських і міжнародних медіа.
# Якщо якийсь URL почав давати помилку у логах [rss] — приберіть або замініть.
RSS_FEEDS=https://www.pravda.com.ua/rss/,https://www.unian.net/rss,https://nv.ua/rss/all.xml,https://lb.ua/rss,https://tsn.ua/rss/full.rss,https://suspilne.media/rss/all.rss,https://www.eurointegration.com.ua/rss/,https://dt.ua/rss,https://zn.ua/rss/,https://www.obozrevatel.com/rss.xml,https://gordonua.com/xml/rss.xml,https://www.ukrinform.net/ukr/rss,https://www.telegraf.com.ua/rss/,https://www.bbc.com/ukrainian/index.xml,https://www.interfax.ru/rss.asp

# Опційно: показувати лише пости зі збігом ключа в заголовку/описі (без фолбеку «останні новини»):
# RSS_STRICT_KEYWORD=1
# RSS_USER_AGENT=SocialAnalyticsDiploma/1.0 (за потреби змінити)

# ============================================================================
#  Telegram — опційно, потребує безкоштовної реєстрації застосунку
# ============================================================================
# 1) Перейти на https://my.telegram.org/apps, увійти своїм Telegram-акаунтом.
# 2) Натиснути «Create new application», заповнити будь-якими даними.
# 3) Отримати `api_id` (число) і `api_hash` (рядок) — підставити нижче.
# 4) Один раз авторизуватись у контейнері:
#       docker compose run --rm nlp python telegram_login.py
#    (потрібно ввести свій номер телефону і код з SMS, як у звичайному вході).
# Файл сесії збережеться у томі `tg-session` і збереже логін між запусками.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=telegram_session
# Публічні @username каналів через кому (до ~10 каналів).
# Зразок (можна замінити на власні україномовні / тематичні канали):
TELEGRAM_CHANNELS=@voynareal,@lvivych_news,@ppo_novunu_ukraine,@tgsn_ua,@V_Zelenskiy_official,@ukrain1an_news,@suspilnenews,@TruexanewsUA,@hromadske_ua

# ============================================================================
#  X (Twitter) — опційно, потребує платного тарифу
# ============================================================================
# З 2023 року безкоштовний тариф X API не дає доступу до Recent Search.
# Потрібен тариф Basic ($200/міс) або вище: https://developer.twitter.com/
# Якщо хочете лише побачити інтеграцію — увімкніть ALLOW_MOCK=1 вище.
# TWITTER_BEARER_TOKEN=
# X_BEARER_TOKEN=                 # альтернативне ім'я тієї ж змінної
# X_LANG_FILTER=uk                # лише україномовні твіти (для EN: X_LANG_FILTER=en)

# ============================================================================
#  Reddit — опційно, безкоштовно
# ============================================================================
# 1) https://www.reddit.com/prefs/apps → «Create another app» → тип `script`.
# 2) Скопіювати `client_id` (під назвою застосунку) і `secret`.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SocialAnalyticsDiploma/1.0 (навчальний проєкт)
