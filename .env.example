# Node.js backend (скопіюйте у .env у корені проєкту або в backend/)
PORT=3000
NLP_SERVICE_URL=http://127.0.0.1:8000
MAX_POSTS=500

# Демо-дані (Twitter/FB тощо): за замовчуванням вимкнено — узгоджено з описом ІС
# ALLOW_MOCK=1

# Асинхронний NLP через Redis (опційно; тоді окремо: cd nlp-service && python worker.py)
# REDIS_URL=redis://127.0.0.1:6379

# RSS / новини — URL стрічок через кому без пробілів між URL.
# У формі аналізу має бути увімкнено «RSS / новини». Ключове слово шукається в заголовку та описі допису.
# Приклади (перевірте актуальність посад у браузері):
# Декілька перевірених стрічок (можна скоротити або дописати свої URL через кому):
RSS_FEEDS=https://www.pravda.com.ua/rss/,https://www.unian.net/rss,https://nv.ua/rss/all.xml,https://lb.ua/rss,https://tsn.ua/rss/full.rss,https://suspilne.media/rss/all.rss,https://www.eurointegration.com.ua/rss/,https://dt.ua/rss,https://zn.ua/rss/,https://www.obozrevatel.com/rss.xml,https://gordonua.com/xml/rss.xml,https://www.ukrinform.net/ukr/rss,https://www.telegraf.com.ua/rss/,https://www.bbc.com/ukrainian/index.xml,https://www.interfax.ru/rss.asp
# Лише дописи де є ключ у заголовку/описі (без резерву «останні новини»):
# RSS_STRICT_KEYWORD=1
# RSS_USER_AGENT=SocialAnalyticsDiploma/1.0 (за потреби змінити)

# --- X (Twitter) API v2 — Recent Search (Bearer Token з developer.twitter.com)
# TWITTER_BEARER_TOKEN=
# Або те саме: X_BEARER_TOKEN=
# Мова твітів (опційно). Не ставте uk для англомовних тем (Tesla, Apple…) — буде 0 результатів. Для EN: X_LANG_FILTER=en або закоментуйте рядок.
# X_LANG_FILTER=uk

# Опційно: Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SocialAnalyticsDiploma/1.0 (навчальний проєкт)

# --- Telegram (реальні канали через Telethon; те саме у nlp-service/.env) ---
# https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=telegram_session
# Публічні @username через кому (до ~10 каналів)
TELEGRAM_CHANNELS=@durov,@telegram
# TELEGRAM_SESSION_DIR=/абсолютний/шлях/до/nlp-service
